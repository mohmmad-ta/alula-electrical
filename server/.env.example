PORT=
NODE_ENV=
API_URL=/api/v1
# Either put credentials directly in MONGOOSE_URL:
# mongodb://USERNAME:PASSWORD@127.0.0.1:27017/alula?authSource=admin
# Or keep the URL credential-free and use the separate values below.
MONGOOSE_URL=mongodb://127.0.0.1:27017
MONGOOSE_DB_NAME=alula
MONGOOSE_USER=
MONGOOSE_PASSWORD=
MONGOOSE_AUTH_SOURCE=admin
MONGOOSE_SERVER_SELECTION_TIMEOUT_MS=10000

JWT_SECRET=
JWT_EXPIRES_IN=
JWT_EXPIRES_IN_DAYS=
JWT_COOKIE_EXPIRES_IN=
ADMIN_JWT_EXPIRES_IN_DAYS=
ADMIN_JWT_COOKIE_EXPIRES_IN=
ADMIN_USER_ID=
ADMIN_PASSWORD=

BACKEND_PUBLIC_URL=https://api.alulaaldhahabi.com


ADMIN_ADDITIONAL_ACCOUNTS_JSON=
